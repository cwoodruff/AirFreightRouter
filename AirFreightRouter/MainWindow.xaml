<Window x:Class="AirFreightRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AirFreightRouter.ViewModels"
        xmlns:views="clr-namespace:AirFreightRouter.Views"
        Title="SkyRoute Express – Air Freight Route Optimizer"
        Width="1280" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMainBrush}"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="O"      Modifiers="Ctrl" Command="{Binding LoadDataCommand}"/>
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding StartComputationCommand}"/>
        <KeyBinding Key="Escape"                  Command="{Binding CancelComputationCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!--
        Root layout: two columns (sidebar | main), two rows (content | status bar)
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================ -->
        <!-- LEFT SIDEBAR                                                      -->
        <!-- ================================================================ -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Logo / header -->
                    <RowDefinition Height="Auto"/>  <!-- Separator -->
                    <RowDefinition Height="Auto"/>  <!-- Load City Data button -->
                    <RowDefinition Height="Auto"/>  <!-- Select All / Deselect All -->
                    <RowDefinition Height="Auto"/>  <!-- "Available Cities" label -->
                    <RowDefinition Height="*"/>     <!-- City list (fills space) -->
                    <RowDefinition Height="Auto"/>  <!-- X of Y summary -->
                    <RowDefinition Height="Auto"/>  <!-- Compute button -->
                    <RowDefinition Height="Auto"/>  <!-- Cancel button -->
                </Grid.RowDefinitions>

                <!-- ── Row 0 · Logo ──────────────────────────────────────── -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgLogoBrush}"
                        Padding="20,22,20,22">
                    <StackPanel Orientation="Horizontal">

                        <!-- Plane icon in an accent-coloured badge -->
                        <Border Background="{StaticResource AccentBrush}"
                                CornerRadius="9" Width="40" Height="40"
                                Margin="0,0,14,0">
                            <TextBlock Text="✈"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="20"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SkyRoute Express"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrightBrush}"/>
                            <TextBlock Text="Optimal Route Calculator"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Row 1 · Separator ─────────────────────────────────── -->
                <Rectangle Grid.Row="1" Height="1"
                           Fill="{StaticResource BorderBrush}"/>

                <!-- ── Row 2 · Load City Data ────────────────────────────── -->
                <Button Grid.Row="2"
                        Content="Load City Data"
                        Command="{Binding LoadDataCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="16,18,16,10"/>

                <!-- ── Row 3 · Bulk-selection helpers ────────────────────── -->
                <Grid Grid.Row="3" Margin="16,0,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Select All"
                            Command="{Binding SelectAllCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Grid.Column="2"
                            Content="Deselect All"
                            Command="{Binding DeselectAllCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>

                <!-- ── Row 4 · Section heading ───────────────────────────── -->
                <TextBlock Grid.Row="4"
                           Text="DELIVERY CITIES"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="18,2,16,6"/>

                <!-- ── Row 5 · Scrollable city list ──────────────────────── -->
                <ListBox Grid.Row="5"
                         ItemsSource="{Binding AvailableCities}"
                         ItemContainerStyle="{StaticResource CityListBoxItemStyle}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Margin="16,0,16,0">
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource CityListBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsComputing}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity"   Value="0.45"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Content="{Binding DisplayName}"
                                      Style="{StaticResource CityCheckBoxStyle}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ── Row 6 · Selection summary ─────────────────────────── -->
                <TextBlock Grid.Row="6"
                           Text="{Binding SelectionSummary}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="16,8,16,10"/>

                <!-- ── Row 7 · Compute button ─────────────────────────────── -->
                <Button Grid.Row="7"
                        Content="Compute Shortest Route"
                        Command="{Binding StartComputationCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="{Binding ComputeButtonTooltip}"
                        ToolTipService.ShowOnDisabled="True"
                        Margin="16,0,16,8"/>

                <!-- ── Row 8 · Cancel button (hidden when idle) ───────────── -->
                <Button Grid.Row="8"
                        Content="Cancel Computation"
                        Command="{Binding CancelComputationCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Visibility="{Binding IsComputing,
                                             Converter={StaticResource BoolToVis}}"
                        Margin="16,0,16,16"/>
            </Grid>
        </Border>

        <!-- ================================================================ -->
        <!-- RIGHT PANEL                                                       -->
        <!--   Row 0 (*):    Map area + floating result-summary overlay       -->
        <!--   Row 1 (Auto): Collapsible results panel (Expander)             -->
        <!-- ================================================================ -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="100"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Row 0 · Interactive map ─────────────────────────────── -->
            <Grid Grid.Row="0">

                <views:RouteMapControl
                    Cities="{Binding MapCities}"
                    Route="{Binding MapRoute}"
                    Origin="{Binding MapOrigin}"
                    IsRouteInProgress="{Binding IsComputing}"
                    RouteStatusText="{Binding MapRouteStatusText}"
                    BestDistanceText="{Binding MapBestDistanceText}"/>

                <!-- Computing spinner — centred on the map while IsComputing=True -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#DD0C0C1A"
                        CornerRadius="12"
                        Padding="20"
                        Visibility="{Binding IsComputing,
                                             Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="44" Height="44"
                             Stroke="{StaticResource AccentBrush}"
                             StrokeThickness="3.5"
                             StrokeDashArray="9 5"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="SpinnerRotate"
                                            Storyboard.TargetProperty="Angle"
                                            From="0" To="360"
                                            Duration="0:0:0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Border>

                <!-- Result overlay — slides in at the top when a route is found -->
                <Border VerticalAlignment="Top"
                        Background="{StaticResource BgResultBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="0,0,0,2"
                        Padding="24,14"
                        Visibility="{Binding HasResult,
                                             Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: route string -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="OPTIMAL ROUTE"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource AccentTextBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding RouteDisplay}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextBrightBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Right: key metrics -->
                        <StackPanel Grid.Column="1"
                                    Margin="32,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding ResultDistanceDisplay}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrightBrush}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding ResultPermutationsDisplay}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding ResultElapsedDisplay}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Row 1 · Results panel (Expander, hidden until result exists) -->
            <Expander Grid.Row="1"
                      Style="{StaticResource ResultsExpanderStyle}"
                      IsExpanded="True"
                      Visibility="{Binding HasResultPanel,
                                           Converter={StaticResource BoolToVis}}">

                <!-- ── Expander header: title + key stats ──────────────── -->
                <Expander.Header>
                    <Border Padding="16,13,0,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>    <!-- Title + distance -->
                            <ColumnDefinition Width="Auto"/> <!-- Permutations -->
                            <ColumnDefinition Width="Auto"/> <!-- Elapsed time -->
                        </Grid.ColumnDefinitions>

                        <!-- Title + total distance (two lines) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ResultPanelTitle}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrightBrush}"/>
                            <TextBlock FontSize="11" Margin="0,4,0,0">
                                <Run Text="Total distance: "
                                     Foreground="{StaticResource TextMutedBrush}"/>
                                <Run Text="{Binding ResultTotalDistanceText, Mode=OneWay}"
                                     Foreground="{StaticResource AccentTextBrush}"
                                     FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Permutations count -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ResultPermutationsText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="24,0,0,0"/>

                        <!-- Elapsed time -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ResultElapsedText}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </Grid>
                    </Border>
                </Expander.Header>

                <!-- ── Expander body: itinerary + statistics footer ─────── -->
                <Grid MaxHeight="260">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--
                        Route itinerary — one flight card per leg.
                        Cards use DataTriggers for:
                          • IsAlternate  → slightly lighter background
                          • IsReturn     → accent left border on the final return leg
                    -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ResultLegs}"
                                      Margin="10,6,10,2"
                                      Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card"
                                            Margin="0,2"
                                            Padding="10,7"
                                            CornerRadius="6"
                                            Background="#1E1E30"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource BorderSubtleBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>   <!-- Leg # badge -->
                                                <ColumnDefinition Width="*"/>    <!-- From city -->
                                                <ColumnDefinition Width="22"/>   <!-- → arrow -->
                                                <ColumnDefinition Width="*"/>    <!-- To city -->
                                                <ColumnDefinition Width="Auto"/> <!-- Return tag -->
                                                <ColumnDefinition Width="86"/>   <!-- Leg dist -->
                                                <ColumnDefinition Width="100"/>  <!-- Cumulative -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Leg number badge -->
                                            <Border Grid.Column="0"
                                                    Background="{StaticResource AccentDimBrush}"
                                                    CornerRadius="4"
                                                    Width="22" Height="22"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LegNumber}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- From city: Name  ST -->
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0">
                                                <Run Text="{Binding FromCity.Name, Mode=OneWay}"
                                                     FontSize="12" FontWeight="SemiBold"
                                                     Foreground="{StaticResource TextBrightBrush}"/>
                                                <Run Text="{Binding FromCity.State, Mode=OneWay}"
                                                     FontSize="10"
                                                     Foreground="{StaticResource TextMutedBrush}"/>
                                            </TextBlock>

                                            <!-- Arrow -->
                                            <TextBlock Grid.Column="2"
                                                       Text="→"
                                                       FontSize="14"
                                                       Foreground="{StaticResource AccentTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <!-- To city: Name  ST -->
                                            <TextBlock Grid.Column="3"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding ToCity.Name, Mode=OneWay}"
                                                     FontSize="12" FontWeight="SemiBold"
                                                     Foreground="{StaticResource TextBrightBrush}"/>
                                                <Run Text="{Binding ToCity.State, Mode=OneWay}"
                                                     FontSize="10"
                                                     Foreground="{StaticResource TextMutedBrush}"/>
                                            </TextBlock>

                                            <!-- "(Return)" tag — only visible on last leg -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding ReturnTag}"
                                                       FontSize="9" FontStyle="Italic"
                                                       Foreground="{StaticResource AccentTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,4,0"/>

                                            <!-- Leg distance -->
                                            <StackPanel Grid.Column="5"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Margin="4,0">
                                                <TextBlock Text="LEG"
                                                           FontSize="8" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding LegDistanceDisplay}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>

                                            <!-- Cumulative distance -->
                                            <StackPanel Grid.Column="6"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Margin="4,0,2,0">
                                                <TextBlock Text="TOTAL"
                                                           FontSize="8" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding CumulativeDistanceDisplay}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Per-card visual variations -->
                                    <DataTemplate.Triggers>
                                        <!-- Alternate row: slightly lighter background -->
                                        <DataTrigger Binding="{Binding IsAlternate}" Value="True">
                                            <Setter TargetName="Card" Property="Background"
                                                    Value="#161625"/>
                                        </DataTrigger>
                                        <!-- Return leg: accent left border + glow -->
                                        <DataTrigger Binding="{Binding IsReturn}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Card" Property="BorderThickness"
                                                    Value="2,1,1,1"/>
                                            <Setter TargetName="Card" Property="Background"
                                                    Value="#15202E"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- ── Statistics footer ─────────────────────────────── -->
                    <Border Grid.Row="1"
                            Background="#15151F"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Average leg distance -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AVG LEG DISTANCE"
                                           FontSize="8" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding ResultAverageLegText}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Longest leg -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="LONGEST LEG"
                                           FontSize="8" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding ResultLongestLegText}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Shortest leg -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SHORTEST LEG"
                                           FontSize="8" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding ResultShortestLegText}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Expander>
        </Grid>

        <!-- ================================================================ -->
        <!-- STATUS BAR                                                        -->
        <!-- ================================================================ -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{StaticResource BgStatusBarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>    <!-- Status message -->
                    <ColumnDefinition Width="260"/>  <!-- Progress bar -->
                    <ColumnDefinition Width="20"/>   <!-- Gap -->
                    <ColumnDefinition Width="Auto"/> <!-- Elapsed time -->
                    <ColumnDefinition Width="16"/>   <!-- Gap -->
                    <ColumnDefinition Width="1"/>    <!-- Divider -->
                    <ColumnDefinition Width="16"/>   <!-- Gap -->
                    <ColumnDefinition Width="Auto"/> <!-- Permutations counter -->
                </Grid.ColumnDefinitions>

                <!-- Status message (truncated if too long) -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Slim progress bar -->
                <ProgressBar Grid.Column="1"
                             Value="{Binding ProgressPercent}"
                             Maximum="100"
                             Height="5"
                             Style="{StaticResource SlimProgressBarStyle}"
                             VerticalAlignment="Center"/>

                <!-- Elapsed time with clock prefix -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="⏱ "
                               FontFamily="Segoe UI Symbol"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ElapsedTimeDisplay}"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Vertical divider -->
                <Rectangle Grid.Column="5"
                           Fill="{StaticResource BorderBrush}"
                           VerticalAlignment="Stretch"/>

                <!-- Permutations counter (empty when idle) -->
                <TextBlock Grid.Column="7"
                           Text="{Binding PermutationsDisplay}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
