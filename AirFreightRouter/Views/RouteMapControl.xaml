<UserControl x:Class="AirFreightRouter.Views.RouteMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Root Grid: Canvas fills all space; InfoOverlay floats in the top-right
        corner as a semi-transparent panel showing live computation status.
        All map drawing is done in code-behind via Canvas.Children.
    -->
    <Grid>

        <Canvas x:Name="MapCanvas"
                Background="#14141E"
                SizeChanged="MapCanvas_SizeChanged"
                ClipToBounds="True"/>

        <!-- ── Info Overlay (top-right) ────────────────────────────── -->
        <Border x:Name="InfoOverlay"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#BB0D1117"
                CornerRadius="8"
                Padding="14,10"
                Margin="12"
                Visibility="Collapsed">
            <StackPanel>
                <!-- Computation status: "Computing…" / "Complete" / "Cancelled (partial)" -->
                <TextBlock x:Name="TbStatus"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <!-- Best distance found so far -->
                <TextBlock x:Name="TbDistance"
                           FontSize="10"
                           Foreground="#99AABBCC"
                           Margin="0,5,0,0"/>

                <!-- Number of delivery cities in the route -->
                <TextBlock x:Name="TbCities"
                           FontSize="10"
                           Foreground="#99AABBCC"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
