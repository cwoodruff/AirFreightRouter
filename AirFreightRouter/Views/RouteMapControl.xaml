<UserControl x:Class="AirFreightRouter.Views.RouteMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Canvas fills all available space.  All drawing is done in code-behind
        via Children.Add / Clear; the XAML only defines the background colour.
    -->
    <Canvas x:Name="MapCanvas"
            Background="#14141E"
            SizeChanged="MapCanvas_SizeChanged"
            ClipToBounds="True"/>

</UserControl>
