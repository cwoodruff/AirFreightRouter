<Window x:Class="AirFreightRouter.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SkyRoute Express"
        Width="480" Height="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgMainBrush}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!--
        Layout:
          Row 0 (44px) — custom title bar with close button
          Row 1 (*)    — content: icon, name, version, description, warning box
          Row 2 (Auto) — footer: tech stack + Close button
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- TITLE BAR                                                         -->
        <!-- ================================================================ -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="About SkyRoute Express"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrightBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>

                <!-- Close button — red hover -->
                <Button HorizontalAlignment="Right"
                        Content="✕"
                        Width="44" Height="44"
                        FontSize="13"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#C42B1C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#A01A0F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ================================================================ -->
        <!-- CONTENT                                                           -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="40,16">

            <!-- App icon badge -->
            <Border Background="{StaticResource AccentBrush}"
                    CornerRadius="14"
                    Width="56" Height="56"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14">
                <TextBlock Text="✈"
                           FontFamily="Segoe UI Symbol"
                           FontSize="26"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Application name -->
            <TextBlock Text="SkyRoute Express"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextBrightBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <!-- Subtitle -->
            <TextBlock Text="Air Freight Route Optimizer"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <!-- Version -->
            <TextBlock Text="Version 1.0.0"
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <!-- Description -->
            <TextBlock TextWrapping="Wrap"
                       MaxWidth="368"
                       TextAlignment="Center"
                       FontSize="12"
                       LineHeight="20"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16">
                Computes the shortest straight-line round-trip route for air
                freight deliveries, starting and ending at Albany, NY.
                Uses Heap's Algorithm (1963) brute-force permutation search
                to guarantee the globally optimal route.
            </TextBlock>

            <!-- Flat-earth assumption warning box -->
            <Border Background="#18182A"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    MaxWidth="368"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}"
                               Margin="0,0,0,6">
                        ⚠  Flat-Earth / Equal-Degree Assumption
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="11"
                               LineHeight="18"
                               Foreground="{StaticResource TextPrimaryBrush}">
                        Distances are computed using Euclidean differences in
                        decimal degrees — one degree of latitude equals one
                        degree of longitude. This is a simplification; real
                        flight paths use great-circle (geodesic) calculations
                        that account for the Earth's curvature. Results are
                        directionally correct for relative route comparisons
                        but are not true geographic distances.
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- FOOTER                                                            -->
        <!-- ================================================================ -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}">
                    <Run>Built with</Run>
                    <Run Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold">.NET 8</Run>
                    <Run>·</Run>
                    <Run Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold">WPF</Run>
                    <Run>·</Run>
                    <Run Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold">CommunityToolkit.Mvvm</Run>
                </TextBlock>

                <Button Grid.Column="1"
                        Content="Close"
                        Width="80"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
